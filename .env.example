# The AI that reads a medicine pack.
#
# Aushadh asks an OpenAI-compatible chat endpoint: a model running on this machine
# (Ollama, LM Studio) or a hosted one. Copy this file to `.env` and fill it in — `.env`
# is never committed, and the values are read at build time.
#
# With a model on this machine, nothing leaves the device. With a hosted one, the pack
# photo and the name you type go to that provider.

EXPO_PUBLIC_AI_BASE_URL=http://localhost:11434/v1
EXPO_PUBLIC_AI_MODEL=llava

# Only for endpoints that ask for a key. Everything prefixed EXPO_PUBLIC_ ships inside
# the app, so treat the key as public.
# EXPO_PUBLIC_AI_API_KEY=
