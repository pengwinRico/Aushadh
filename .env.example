# The AI that reads a medicine pack.
#
# Aushadh asks an OpenAI-compatible chat endpoint: a model running on this machine
# (Ollama, LM Studio) or a hosted one. Copy this file to `.env` and fill it in — `.env`
# is never committed, and the values are read at build time.
#
# With a model on this machine, nothing leaves the device. With a hosted one, the pack
# photo and the name you type go to that provider.

# A model on this machine, which needs no key:
EXPO_PUBLIC_AI_BASE_URL=http://localhost:11434/v1
EXPO_PUBLIC_AI_MODEL=llava

# Or Google AI Studio (Gemma), which speaks the same dialect. Make a key at
# https://aistudio.google.com/apikey and use its OpenAI-compatible endpoint:
#
#   EXPO_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EXPO_PUBLIC_AI_MODEL=gemma-4-31b-it
#   EXPO_PUBLIC_AI_API_KEY=<the key>
#
# Gemma 4 reads images. `gemini-3.8-flash` sits on the same URL if a model name is not
# served there.

# The key is only for endpoints that ask for one. Everything prefixed EXPO_PUBLIC_ ships
# inside the app, so treat the key as public.
# EXPO_PUBLIC_AI_API_KEY=
